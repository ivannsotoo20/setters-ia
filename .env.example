# ============================================================================
# Fyzon Setters IA — variables de entorno
#
# Cómo se usa:
#   1. Copia este archivo a `.env.local` (gitignored): cp .env.example .env.local
#   2. Rellena los placeholders con valores reales (Ivan los entrega).
#   3. Tanto el motor como el panel leen del mismo `.env.local` en dev.
#
# Reglas duras:
#   - SUPABASE_SERVICE_ROLE_KEY solo se usa en `apps/motor-agente`.
#     NUNCA expongas service_role al panel ni al browser. Romperías RLS.
#   - Todo lo prefijado con NEXT_PUBLIC_ se inlinea al bundle del browser.
#     Ahí solo deben ir valores no-secretos (URL Supabase + anon key).
#   - ANTHROPIC_API_KEY tiene coste real por token. No la pongas en código.
# ============================================================================

# ----------------------------------------------------------------------------
# Supabase — base de datos + auth + storage + realtime
# ----------------------------------------------------------------------------
# URL del proyecto Supabase (es la misma para el motor y el panel).
SUPABASE_URL=https://ppujrqxiizgfqclbuxet.supabase.co

# Anon / publishable key. Sale al browser, está protegida por RLS.
SUPABASE_ANON_KEY=eyJ...

# Service role key. SOLO motor-agente. Bypassea RLS — trátala como root password.
SUPABASE_SERVICE_ROLE_KEY=eyJ...

# Mismas dos vars con prefijo NEXT_PUBLIC_ para que Next.js las inlinee al bundle.
NEXT_PUBLIC_SUPABASE_URL=https://ppujrqxiizgfqclbuxet.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJ...

# ----------------------------------------------------------------------------
# Anthropic — modelo IA (Sonnet 4.5 + Haiku 4.5)
# ----------------------------------------------------------------------------
# Solo motor-agente. Tiene coste por token.
ANTHROPIC_API_KEY=sk-ant-api03-...

# ----------------------------------------------------------------------------
# Redis — debounce buffer + dedup webhooks
# ----------------------------------------------------------------------------
# En dev local con docker compose: redis://redis:6379 (dentro del compose) o
# redis://localhost:6379 (corriendo el motor fuera de docker).
# En prod (Contabo VPS): redis://<host-interno>:6379
REDIS_URL=redis://localhost:6379

# ----------------------------------------------------------------------------
# Motor agente (Fastify) — runtime config
# ----------------------------------------------------------------------------
PORT=3001
LOG_LEVEL=info
NODE_ENV=development

# Base URL de la API ManyChat. Solo cambia si haces self-host (raro).
MANYCHAT_API_BASE=https://api.manychat.com

# Base URL de la API YCloud (BSP oficial Meta para WhatsApp). Solo cambia para mocks/testing.
YCLOUD_API_BASE=https://api.ycloud.com

# ----------------------------------------------------------------------------
# Credentials encryption (Hardening 1.1) — AES-256-GCM
# ----------------------------------------------------------------------------
# Cifra `integration_accounts.credentials_encrypted` at-rest. 32 bytes hex.
# Genera con: `openssl rand -hex 32`
# Guárdala fuera del repo (.env.local). Si se rota, hay que re-encriptar
# todos los registros existentes (script scripts/encrypt-credentials.mjs).
# Opcional en dev (las funciones encrypt/decrypt fallan si no está). Obligatoria
# antes de cualquier outbound real con tenants productivos.
CREDENTIALS_ENCRYPTION_KEY=

# ----------------------------------------------------------------------------
# Webhook verification (Hardening 1.2)
# ----------------------------------------------------------------------------
# Modo de verificación HMAC del webhook YCloud:
#   disabled → no se verifica firma (legacy / compat).
#   warn     → se verifica si llega; si falla, log warn y continúa (default en transición).
#   enforce  → la firma DEBE ser válida o se devuelve 401.
# Migrar a `enforce` solo cuando se confirme que el panel YCloud está enviando firmas
# correctamente y `integration_accounts.webhook_secret` contiene el secret real
# de la "Retrieve a webhook endpoint API" de YCloud (no el placeholder del seed).
YCLOUD_WEBHOOK_VERIFY_MODE=warn

# ----------------------------------------------------------------------------
# Internal stats endpoint (Hardening 1.3)
# ----------------------------------------------------------------------------
# Bearer token para GET /internal/stats. Si está vacío, el endpoint devuelve 503.
# Generar con: openssl rand -hex 32
# Solo se usa para inspección interna (curl con Authorization: Bearer <token>).
# No expones este endpoint a clientes ni al panel sin VPN.
INTERNAL_STATS_TOKEN=

# ----------------------------------------------------------------------------
# Panel Next.js — runtime config (opcional)
# ----------------------------------------------------------------------------
# Origen público del panel. En dev con `pnpm --filter @fyzon/panel dev`
# es http://localhost:3000. En prod (Vercel) lo gestiona Vercel automáticamente.
# Si lo dejas vacío, el server lo deduce del header Host.
# NEXT_PUBLIC_PANEL_ORIGIN=http://localhost:3000

# ----------------------------------------------------------------------------
# Resend — Notificaciones email al trainer (Sprint Gamma 2.4)
# ----------------------------------------------------------------------------
# El motor envía emails al trainer cuando se disparan eventos (handoff,
# qualified, appointment_booked, etc). El trainer elige qué eventos quiere
# recibir desde /settings/preferences.
#
# Sin RESEND_API_KEY el cron skipea envíos (status='failed' tras 3 intentos).
# Obtener API key desde panel Resend: https://resend.com/api-keys
RESEND_API_KEY=
# Email del FROM. Debe estar verificado en Resend (SPF/DKIM correctos en el
# dominio). Default usa fyzon.es — configurar antes en producción.
RESEND_FROM_EMAIL=alertas@fyzon.es
RESEND_FROM_NAME=Fyzon Setters
# URL pública del panel para enlaces "Ver conversación" en los emails.
PANEL_PUBLIC_URL=https://panel.fyzon.es
