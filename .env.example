# ============================================================================
# Fyzon Setters IA — variables de entorno
#
# Cómo se usa:
#   1. Copia este archivo a `.env.local` (gitignored): cp .env.example .env.local
#   2. Rellena los placeholders con valores reales (Ivan los entrega).
#   3. Tanto el motor como el panel leen del mismo `.env.local` en dev.
#
# Reglas duras:
#   - SUPABASE_SERVICE_ROLE_KEY solo se usa en `apps/motor-agente`.
#     NUNCA expongas service_role al panel ni al browser. Romperías RLS.
#   - Todo lo prefijado con NEXT_PUBLIC_ se inlinea al bundle del browser.
#     Ahí solo deben ir valores no-secretos (URL Supabase + anon key).
#   - ANTHROPIC_API_KEY tiene coste real por token. No la pongas en código.
# ============================================================================

# ----------------------------------------------------------------------------
# Supabase — base de datos + auth + storage + realtime
# ----------------------------------------------------------------------------
# URL del proyecto Supabase (es la misma para el motor y el panel).
SUPABASE_URL=https://ppujrqxiizgfqclbuxet.supabase.co

# Anon / publishable key. Sale al browser, está protegida por RLS.
SUPABASE_ANON_KEY=eyJ...

# Service role key. SOLO motor-agente. Bypassea RLS — trátala como root password.
SUPABASE_SERVICE_ROLE_KEY=eyJ...

# Mismas dos vars con prefijo NEXT_PUBLIC_ para que Next.js las inlinee al bundle.
NEXT_PUBLIC_SUPABASE_URL=https://ppujrqxiizgfqclbuxet.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJ...

# ----------------------------------------------------------------------------
# Anthropic — modelo IA (Sonnet 4.5 + Haiku 4.5)
# ----------------------------------------------------------------------------
# Solo motor-agente. Tiene coste por token.
ANTHROPIC_API_KEY=sk-ant-api03-...

# ----------------------------------------------------------------------------
# Redis — debounce buffer + dedup webhooks
# ----------------------------------------------------------------------------
# En dev local con docker compose: redis://redis:6379 (dentro del compose) o
# redis://localhost:6379 (corriendo el motor fuera de docker).
# En prod (Contabo VPS): redis://<host-interno>:6379
REDIS_URL=redis://localhost:6379

# ----------------------------------------------------------------------------
# Motor agente (Fastify) — runtime config
# ----------------------------------------------------------------------------
PORT=3001
LOG_LEVEL=info
NODE_ENV=development

# Base URL de la API ManyChat. Solo cambia si haces self-host (raro).
MANYCHAT_API_BASE=https://api.manychat.com

# Base URL de la API YCloud (BSP oficial Meta para WhatsApp). Solo cambia para mocks/testing.
YCLOUD_API_BASE=https://api.ycloud.com

# ----------------------------------------------------------------------------
# Credentials encryption (Hardening 1.1) — AES-256-GCM
# ----------------------------------------------------------------------------
# Cifra `integration_accounts.credentials_encrypted` at-rest. 32 bytes hex.
# Genera con: `openssl rand -hex 32`
# Guárdala fuera del repo (.env.local). Si se rota, hay que re-encriptar
# todos los registros existentes (script scripts/encrypt-credentials.mjs).
# Opcional en dev (las funciones encrypt/decrypt fallan si no está). Obligatoria
# antes de cualquier outbound real con tenants productivos.
CREDENTIALS_ENCRYPTION_KEY=

# ----------------------------------------------------------------------------
# Webhook verification (Hardening 1.2 + Hito 9)
# ----------------------------------------------------------------------------
# Modo de verificación HMAC del webhook YCloud:
#   disabled → no se verifica firma (legacy / compat).
#   warn     → se verifica si llega; si falla, log warn y continúa (default en transición).
#   enforce  → la firma DEBE ser válida o se devuelve 401.
# Migrar a `enforce` solo cuando se confirme que el panel YCloud está enviando firmas
# correctamente y `integration_accounts.webhook_secret` contiene el secret real
# de la "Retrieve a webhook endpoint API" de YCloud (no el placeholder del seed).
YCLOUD_WEBHOOK_VERIFY_MODE=warn

# Modo de verificación shared-secret del endpoint POST /automations/lead-form
# (Hito 9 sub-fase 3). Reusa integration_accounts.webhook_secret de la cuenta
# YCloud activa del tenant. El cliente externo (n8n / GHL Workflow / Tally /
# Meta Lead Ads) debe pasarlo en header X-Form-Secret.
#   disabled → skip verificación (dev local).
#   warn     → log si missing/mismatch + continúa (transición).
#   enforce  → header missing/mismatch → 401.
# Recomendado: warn en dev/staging, enforce en producción.
LEAD_FORM_VERIFY_MODE=warn

# ----------------------------------------------------------------------------
# GHL Marketplace OAuth (Bloque C.E + Hito 9 conector de origen IG/FB)
# ----------------------------------------------------------------------------
# Credenciales de la app Fyzon Marketplace en GoHighLevel. Cada trainer instala
# la app en su sub-cuenta GHL via OAuth flow y queda registrada en
# integration_accounts(provider='ghl'). El motor refresca tokens automáticamente
# cuando quedan <5min de TTL (lib/ghl-oauth.ts).
#
# Obtener desde developer portal GHL → My Apps → tu app → Settings.
GHL_OAUTH_CLIENT_ID=
GHL_OAUTH_CLIENT_SECRET=
# Shared secret para HMAC verification de webhooks que la app emite.
GHL_OAUTH_SHARED_SECRET=
# URL pública del callback OAuth. Debe coincidir EXACTAMENTE con la registrada
# en developer portal. NO puede contener "ghl" o "highlevel" (limitación GHL).
GHL_OAUTH_REDIRECT_URI=https://setter-dev.fyzon.es/integrations/oauth/callback
# Scopes solicitados al instalar — separados por espacio.
GHL_OAUTH_SCOPES=contacts.write contacts.readonly conversations.readonly conversations.write conversations/message.readonly conversations/message.write locations.readonly
# Base URL de GHL services API v2.
GHL_API_BASE=https://services.leadconnectorhq.com
# Base URL de Marketplace OAuth (chooselocation redirect).
GHL_MARKETPLACE_BASE=https://marketplace.gohighlevel.com
# Version ID de la app GHL Marketplace. Sin esto, GHL devuelve `error.noAppVersionIdFound`.
# Encontrar en developer portal → tu app → Install link (botón Show).
GHL_OAUTH_VERSION_ID=

# Modo de verificación firma RSA-SHA256 del webhook GHL Workflow + Marketplace:
#   disabled → skip (dev local sin pubkey).
#   warn     → verifica si hay header + pubkey; si falla, log warn y continúa.
#   enforce  → falta firma o falla → 401.
GHL_WEBHOOK_VERIFY_MODE=warn

# Clave pública RSA distribuida por GHL Marketplace (formato PEM completo con
# BEGIN/END PUBLIC KEY). Si vacía y verify_mode != disabled → toda firma se
# trata como signature_mismatch.
GHL_WEBHOOK_PUBLIC_KEY_PEM=

# ----------------------------------------------------------------------------
# Internal stats + welcome endpoints (Hardening 1.3 + Hito 9 sub-fase 4)
# ----------------------------------------------------------------------------
# Bearer token para GET /internal/stats Y POST /internal/welcome (sub-fase 4).
# Si está vacío, ambos endpoints devuelven 503.
# Generar con: openssl rand -hex 32
# Se usa también desde el panel para llamar a /internal/welcome — debe estar
# en .env.local del panel también (mismo valor).
INTERNAL_STATS_TOKEN=

# ----------------------------------------------------------------------------
# Panel Next.js — runtime config (opcional)
# ----------------------------------------------------------------------------
# Origen público del panel. En dev con `pnpm --filter @fyzon/panel dev`
# es http://localhost:3000. En prod (Vercel) lo gestiona Vercel automáticamente.
# Si lo dejas vacío, el server lo deduce del header Host.
# NEXT_PUBLIC_PANEL_ORIGIN=http://localhost:3000

# URL del motor desde el panel para llamadas server-to-server (server actions
# del panel → /internal/welcome del motor para botón "Enviar bienvenida").
# En dev: http://localhost:3001. En prod: URL interna del motor (no expuesta).
MOTOR_INTERNAL_URL=http://localhost:3001
# URL pública del motor (para que el wizard onboarding muestre la URL del
# webhook lead-form al trainer copy-paste). Puede ser igual a MOTOR_INTERNAL_URL
# en dev. En prod: dominio público del motor (ej. https://setter.fyzon.es).
# NEXT_PUBLIC_MOTOR_ORIGIN=http://localhost:3001

# ----------------------------------------------------------------------------
# Resend — Notificaciones email al trainer (Sprint Gamma 2.4)
# ----------------------------------------------------------------------------
# El motor envía emails al trainer cuando se disparan eventos (handoff,
# qualified, appointment_booked, etc). El trainer elige qué eventos quiere
# recibir desde /settings/preferences.
#
# Sin RESEND_API_KEY el cron skipea envíos (status='failed' tras 3 intentos).
# Obtener API key desde panel Resend: https://resend.com/api-keys
RESEND_API_KEY=
# Email del FROM. Debe estar verificado en Resend (SPF/DKIM correctos en el
# dominio). Default usa fyzon.es — configurar antes en producción.
RESEND_FROM_EMAIL=alertas@fyzon.es
RESEND_FROM_NAME=Fyzon Setters
# URL pública del panel para enlaces "Ver conversación" en los emails.
PANEL_PUBLIC_URL=https://panel.fyzon.es
