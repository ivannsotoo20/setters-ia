    {
      "parameters": {
        "operation": "executeQuery",
        "query": "-- Reserva creada: F(agendado) + booking_status=booked + se apaga el seguimiento.\n-- pipeline_stage tambien a agendado (espejo del custom field viejo de GHL).\nUPDATE public.clientes_crm_tania\nSET booking_status = 'booked',\n    stage_v4 = 'agendado',\n    pipeline_stage = 'agendado',\n    proximo_recontacto = NULL,\n    recontacto_motivo = NULL\nWHERE contact_id = $1\nRETURNING id, nombre;",
        "options": {
          "queryReplacement": "={{ [ $('normalizar booking').first().json.contact_id ] }}"
        }
      },
      "id": "4c2918bb-8cfc-46c9-a539-8243881a8d30",
      "name": "crm: agendado",
