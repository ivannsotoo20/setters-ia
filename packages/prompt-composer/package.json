{
  "name": "@fyzon/prompt-composer",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Ensambla el system prompt desde prompt_blocks: core_v4 + coach_v3 + admin_overrides + fase + ... + trainer_prefs, con cache breakpoints",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "files": ["dist", "src"],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "lint": "echo 'lint not configured yet'",
    "test": "vitest run",
    "clean": "rm -rf dist .tsbuildinfo"
  },
  "dependencies": {
    "@fyzon/db": "workspace:*",
    "@supabase/supabase-js": "^2.47.12"
  },
  "devDependencies": {
    "typescript": "^5.7.2",
    "vitest": "^2.1.9"
  }
}
