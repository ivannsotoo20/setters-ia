{
  "name": "setters-ia",
  "version": "0.1.0",
  "private": true,
  "description": "Fyzon Setters IA — SaaS multi-tenant para setters de WhatsApp/IG/FB",
  "packageManager": "pnpm@10.33.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
