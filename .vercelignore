# Vercel ignore — minimize upload to Vercel
# Mirrors .gitignore but enforced even when proyecto no está linkeado a Git

# Dependencies (Vercel re-instala via pnpm install)
node_modules/
.pnpm-store/

# Build outputs (Vercel los regenera)
.next/
.turbo/
dist/
build/
out/
.cache/
coverage/
*.tsbuildinfo

# Infra que NO necesita el panel (motor vive en VPS Contabo)
docker-compose.yml
docker-compose.dev.yml
Dockerfile
scripts/

# Env files (Vercel usa sus propias env vars)
.env
.env.local
.env.*.local

# Tunneling / OS noise
*.cloudflared.log
*.log
.DS_Store
Thumbs.db
*.swp
*.tmp
.tmp/

# IDE
.idea/
.vscode/

# Claude / docs personales
.claude/
docs/
