{
  "name": "@fyzon/motor-agente",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Motor del agente de setters IA — webhooks, pipeline 3-LLM, validador, scheduler",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc",
    "start": "node dist/index.js",
    "typecheck": "tsc --noEmit",
    "lint": "echo 'lint not configured yet'",
    "test": "vitest run",
    "test:watch": "vitest",
    "preview-prompt": "tsx scripts/preview-prompt.ts",
    "run-generator": "tsx scripts/run-generator.ts",
    "run-pipeline": "tsx scripts/run-pipeline.ts",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.73.0",
    "@fastify/cors": "^10.0.1",
    "@fastify/helmet": "^12.0.1",
    "@fyzon/agent-pipeline": "workspace:*",
    "@fyzon/channel-adapters": "workspace:*",
    "@fyzon/db": "workspace:*",
    "@fyzon/ghl-client": "workspace:*",
    "@fyzon/prompt-composer": "workspace:*",
    "@fyzon/shared-validator": "workspace:*",
    "@supabase/supabase-js": "^2.47.12",
    "dotenv": "^16.4.7",
    "fastify": "^5.2.1",
    "ioredis": "^5.4.2",
    "pino": "^9.6.0",
    "pino-pretty": "^13.0.0",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "ioredis-mock": "^8.13.1",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vitest": "^2.1.9"
  }
